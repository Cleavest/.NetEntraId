@{
    ViewData["Title"] = "Σύνδεση";
    Layout = "_LoginLayout";
}

<div class="login-container">
    <div class="card shadow-lg border-0" style="width: 400px; border-radius: 16px;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                <h3 class="fw-bold">Admin Panel</h3>
                <p class="text-muted">Σύνδεση στο σύστημα</p>
            </div>

            <a href="@Url.Action("SignIn", "Account", new { returnUrl = ViewBag.ReturnUrl })" class="btn btn-primary btn-lg w-100">
                <i class="fab fa-microsoft me-2"></i>Σύνδεση με Microsoft
            </a>

            <div class="text-center mt-3">
                <small class="text-muted">Χρησιμοποίησε τον οργανισμό σου για σύνδεση</small>
            </div>
        </div>
    </div>
</div>
