@model AdminPanel.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-1">Καλωσήρθες, @Model.UserName</h2>
                            <p class="mb-0 opacity-75">@Model.UserEmail</p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-warning text-dark fs-6 me-2">
                                <i class="fas fa-user-tag me-1"></i>@Model.Role
                            </span>
                            <span class="badge bg-light text-primary fs-6">
                                <i class="fas fa-shield-alt me-1"></i>Authenticated
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">
                <i class="fas fa-th-large me-2"></i>Διαχείριση CMS
            </h3>
            @if (Model.Role == "Viewer")
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Ο ρόλος <strong>Viewer</strong> δεν έχει πρόσβαση σε CMS. Επικοινώνησε με τον admin.
                </div>
            }
            else
            {
                <p class="text-muted mb-4">Επίλεξε ένα CMS για να μεταβείς με αυτόματο SSO login</p>
            }
        </div>
    </div>

    @if (Model.CmsLinks.Any())
    {
        <div class="row g-4">
            @foreach (var cms in Model.CmsLinks)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 cms-card">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <div class="cms-icon-wrapper me-3">
                                    <i class="@cms.Icon fa-2x"></i>
                                </div>
                                <div>
                                    <h5 class="card-title mb-0">@cms.Name</h5>
                                    @if (cms.SsoEnabled)
                                    {
                                        <span class="badge bg-success mt-1">
                                            <i class="fas fa-key me-1"></i>SSO Enabled
                                        </span>
                                    }
                                </div>
                            </div>
                            <p class="card-text text-muted flex-grow-1">@cms.Description</p>
                            <a href="@Url.Action("SsoRedirect", "Home", new { url = cms.Url })"
                               class="btn btn-primary mt-auto">
                                <i class="fas fa-external-link-alt me-2"></i>Μετάβαση στο CMS
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="row mt-4">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body">
                    <h5><i class="fas fa-bug me-2"></i>Debug: Claims</h5>
                    <ul class="list-unstyled mb-0">
                        @foreach (var claim in Model.DebugClaims)
                        {
                            <li><code>@claim</code></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .cms-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .cms-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
    }
    .cms-icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }
</style>
