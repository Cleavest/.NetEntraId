@{
    ViewData["Title"] = "Αποσύνδεση";
    Layout = "_LoginLayout";
}

<div class="login-container">
    <div class="card shadow-lg border-0" style="width: 400px; border-radius: 16px;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <h3 class="fw-bold">Αποσυνδέθηκες</h3>
                <p class="text-muted">Η συνεδρία σου έληξε επιτυχώς</p>
            </div>

            <a href="@Url.Action("SignIn", "Account")" class="btn btn-primary btn-lg w-100">
                <i class="fab fa-microsoft me-2"></i>Σύνδεση με Microsoft
            </a>
        </div>
    </div>
</div>
